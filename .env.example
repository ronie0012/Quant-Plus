# Copy these settings into .env.local (ignored by Git).
# The local profile and its paper book need no cloud database credentials.
# Optional local storage path (default: .local-data/workspace.json).
# LOCAL_DATA_FILE=
# Set to "off" to disable the in-process paper worker (resting orders, protections, alerts, expiry).
# QUANT_PLUS_WORKER=
AGENT_SERVICE_URL=http://127.0.0.1:8000
# Must match WEBSITE_API_KEY in D:/QP/agent-service/.env. Server-only.
AGENT_SERVICE_API_KEY=
# Server-only Quant AI chatbot credentials. Never use VITE_ prefixes.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Hosted InsForge accounts (disabled unless all of these are set; see INSFORGE_MIGRATION.md) ---
# Server-only: enables hosted books and the admin key used for atomic commits. Never prefix with VITE_.
# QUANT_PLUS_BOOK_PROVIDER=insforge
# INSFORGE_URL=https://htaen3qu.us-east.insforge.app
# INSFORGE_API_KEY=
# INSFORGE_ANON_KEY=
# Browser: the public anon key only (npx -y @insforge/cli secrets get ANON_KEY).
# VITE_QUANT_PLUS_AUTH=insforge
# VITE_INSFORGE_URL=https://htaen3qu.us-east.insforge.app
# VITE_INSFORGE_ANON_KEY=
